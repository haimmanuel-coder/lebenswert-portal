# ─────────────────────────────────────────────────────────────────────────────
#  Umgebungsvariablen für das Lebenswert-Portal
#  Diese Datei ist eine VORLAGE. Kopiere sie zu ".env" und trage echte Werte ein.
#  ".env" wird NICHT eingecheckt (siehe .gitignore) – Geheimnisse bleiben lokal.
# ─────────────────────────────────────────────────────────────────────────────

# ── PFLICHT: Kernbetrieb ─────────────────────────────────────────────────────

# MySQL-Datenbank (MySQL 8 oder MariaDB). Format:
#   mysql://BENUTZER:PASSWORT@HOST:3306/DATENBANKNAME
DATABASE_URL=mysql://portal:changeme@localhost:3306/lebenswert

# Geheimer Schlüssel für Login-Tokens UND die Verschlüsselung gespeicherter
# Zugangsdaten. Mindestens 16 Zeichen, zufällig. In Produktion PFLICHT – ohne
# diesen Wert startet die App im Produktionsmodus nicht.
# Beispiel erzeugen: openssl rand -base64 48
JWT_SECRET=

# Laufzeitmodus und Port
NODE_ENV=production
PORT=3000

# ── START-ADMIN (einmaliges Bootstrapping bei leerer Installation) ────────────
# Legt beim ersten Start EIN Admin-Konto an – aber nur, wenn noch KEIN Admin
# existiert. Auf einem bereits befüllten System wirkungslos. Nach dem ersten
# Login SEED_ADMIN_PASSWORT wieder entfernen und das Passwort im Portal ändern.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORT=
SEED_ADMIN_NAME=Admin Portal

# ── E-MAIL (Passwort-Reset, Benachrichtigungen) ──────────────────────────────
# Ohne SMTP funktioniert der Portalbetrieb, aber es werden keine E-Mails
# (z. B. Passwort-Reset) versendet.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── OPTIONAL: Verschlüsselung von Integrations-Zugangsdaten ──────────────────
# Fällt auf JWT_SECRET zurück, wenn nicht gesetzt.
CREDENTIAL_ENCRYPTION_KEY=

# ── OPTIONAL: Web-Push-Benachrichtigungen ────────────────────────────────────
# Nur nötig, wenn Push-Nachrichten genutzt werden. Erzeugen: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── OPTIONAL: Redis (Cache/Job-Status) ───────────────────────────────────────
# Die App läuft auch ohne Redis.
REDIS_URL=

# ── DATEI-SPEICHER (S3-kompatibel) – Ersatz für den Manus/Forge-Speicher ──────
# Wird verwendet, sobald S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY
# gesetzt sind (Unterschriften, Backups, Export-Pakete). Läuft mit jedem
# S3-kompatiblen EU-Anbieter (AWS S3 eu-*, Hetzner Object Storage, IONOS, MinIO …).
# Sind diese Werte leer, greift – falls vorhanden – der Manus/Forge-Speicher.
S3_BUCKET=
S3_REGION=eu-central-1
# Endpunkt des Anbieters; für echtes AWS S3 leer lassen (Standard-Endpunkt).
# Beispiel Hetzner: https://fsn1.your-objectstorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nicht-AWS-Anbieter benötigen meist Path-Style-URLs (Standard: true).
S3_FORCE_PATH_STYLE=true

# ── KI (LLM) – OpenAI-kompatibler Anbieter, Ersatz für Forge-KI ───────────────
# Berichtsvorschläge/Analysen. Läuft mit jedem OpenAI-kompatiblen Endpunkt
# (OpenAI, Mistral, Azure OpenAI, self-hosted). Ohne diese Werte greift Forge.
LLM_API_URL=
LLM_API_KEY=
# Modellname (bei eigenem Anbieter i. d. R. nötig), z. B. gpt-4o-mini
LLM_MODEL=

# ── SPRACHE-ZU-TEXT (STT) – OpenAI-/Whisper-kompatibel, Ersatz für Forge-STT ──
# Transkription der Besuchsberichte. Ohne diese Werte greift Forge.
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ── KARTEN – eigener Google-Maps-Schlüssel, Ersatz für den Forge-Maps-Proxy ───
# Serverseitig (Geocoding/Distanzen für die Tourenplanung).
GOOGLE_MAPS_API_KEY=
# Browser-Kartenanzeige: build-zeitlicher Schlüssel (Vite). Muss beim BUILD
# gesetzt sein (bei Docker als Build-Argument). Ohne diesen Wert greift Forge.
VITE_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  MANUS/FORGE – nur auf der Manus-Plattform vorhanden.
#  Beim Umzug auf einen eigenen Webhoster sind diese Werte NICHT verfügbar.
#  Betroffene Funktionen (Datei-Speicher, KI, Karten) müssen dann durch eigene
#  Dienste ersetzt oder deaktiviert werden – siehe README.md, Abschnitt „Umzug".
# ─────────────────────────────────────────────────────────────────────────────
# Datei-Speicher (Unterschriften, Backups, Export-Pakete), KI, Karten:
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Manus-OAuth (Login läuft bereits über eigene E-Mail/Passwort-Anmeldung,
# daher für den Kernbetrieb nicht erforderlich):
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
# Build-Zeit-Kennung der Manus-App (Frontend):
VITE_APP_ID=
